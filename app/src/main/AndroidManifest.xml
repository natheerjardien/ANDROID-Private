<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission is required for network communication (Android Developers, 2026a). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Permission is required to modify audio settings for the Equalizer (Android Developers, 2026c). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/tuniq_music_player"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/tuniq_music_player"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tuniq"
        tools:targetApi="31">

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".AccountActivity"
            android:exported="false" />

        <activity
            android:name=".EqualizerActivity"
            android:exported="false" />

        <activity
            android:name=".SleepTimerActivity"
            android:exported="false" />

        <service
            android:name=".media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- MainActivity handles the main app flow and the Spotify Deep Link redirect -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- Spotify Deep Link Interceptor (Android Developers, 2026b). -->
            <intent-filter>

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Matches the Redirect URI registered in the Spotify Dashboard -->
                <data
                    android:host="callback"
                    android:scheme="tuniq" />

            </intent-filter>

        </activity>

    </application>

    <!--
         Reference List:
         Android Developers, 2026a. Connect to the network. [Online]
         Available at: https://developer.android.com/training/basics/network-ops/connecting
         [Accessed 17 September 2026].

         Android Developers, 2026b. Create Deep Links to App Content. [Online]
         Available at: https://developer.android.com/training/app-links/deep-linking
         [Accessed 17 September 2026].

         Android Developers, 2026c. Equalizer. [Online].
         Available at: https://developer.android.com/reference/android/media/audiofx/Equalizer
         [Accessed 17 September 2026].
    -->

</manifest>